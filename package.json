{
  "name": "headless-site-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "tinacms build && next build && node scripts/generate-agent-markdown.mjs && node scripts/generate-discovery.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:discovery": "node scripts/audit-discovery.mjs",
    "build:local": "NODE_ENV=production tinacms build --local --skip-cloud-checks -c \"next build && node scripts/generate-agent-markdown.mjs && node scripts/generate-discovery.mjs\"",
    "worker:dev": "npm run build:local && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "worker:check": "wrangler deploy --dry-run",
    "launch:issues": "node scripts/create-launch-issues.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "next": "^15.5.19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tinacms": "^3.8.4"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.4.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
